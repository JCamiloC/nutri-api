PORT=4000
NODE_ENV=development
# Origen(es) del front. Separar con coma si hay varios.
# Ejemplo prod: https://tunutrisaas.com,https://www.tunutrisaas.com
CORS_ORIGIN=http://localhost:3002

# Postgres local vía Docker Compose (npm run db:setup)
# user/pass/db: nutri / nutri / nutri_lab
DATABASE_URL=postgresql://nutri:nutri@127.0.0.1:5432/nutri_lab

# Producción / VPS (ejemplo)
# DATABASE_URL=postgresql://nutri:PASSWORD@127.0.0.1:5432/nutri_lab

# USDA FoodData Central — solo servidor (nunca en el front)
# Local: DEMO_KEY (límite bajo). Producción: clave data.gov
USDA_API_KEY=DEMO_KEY

# Auth JWT (cambiar en producción)
JWT_SECRET=nutri-dev-secret-change-me
# Access token corto; el front renueva con refresh
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_HOURS=2
# URL pública del front (enlaces de alta, reset e invitación)
# APP_PUBLIC_URL=https://tunutrisaas.com
# URL pública del API (logo en correos HTML; debe ser alcanzable por el cliente de correo)
# API_PUBLIC_URL=https://api.tudominio.com
# Código MFA por correo (minutos de vigencia)
MFA_CODE_MINUTES=10

# SMTP — listo para correo corporativo Enerxis.
# Mientras estas vars estén vacías, el mailer opera en MOCK
# (log en el API + smtpPending en la respuesta; el superadmin ve la contraseña temporal).
# Cuando las tengas, descomenta y rellena; no hace falta cambiar código:
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NutriLab <noreply@enerxis.com>"
# SMTP_SECURE=false
# SUPPORT_EMAIL=soporte@enerxis.com

# Nota local: si Cursor ocupa :4000, usa PORT=4001 en tu .env (no commitear .env)
