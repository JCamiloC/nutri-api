PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3002

# Postgres local vía Docker Compose (npm run db:setup)
# user/pass/db: nutri / nutri / nutri_lab
DATABASE_URL=postgresql://nutri:nutri@127.0.0.1:5432/nutri_lab

# Producción / VPS (ejemplo)
# DATABASE_URL=postgresql://nutri:PASSWORD@127.0.0.1:5432/nutri_lab

# USDA FoodData Central — solo servidor (nunca en el front)
USDA_API_KEY=

# Auth JWT (cambiar en producción)
JWT_SECRET=nutri-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Nota local: si Cursor ocupa :4000, usa PORT=4001 en tu .env (no commitear .env)
